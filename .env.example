APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SERVER_PORT=8002

# Loopback only, deliberately: this service answers the gateway, which runs on
# the same host, and nothing else. Binding it to 0.0.0.0 would publish it to
# the network, where the only thing standing between it and a stranger is the
# GATEWAY_TOKEN check -- one layer instead of two. Laravel already defaults to
# 127.0.0.1; this states it so the default cannot drift.
#
# Note that an explicit `php artisan serve --host=...` still overrides this.
SERVER_HOST=127.0.0.1


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Proves a request came from the gateway.
#
# The JWT proves who is calling; this proves what is calling, and unlike the
# JWT it is on every request -- the public storefront routes carry no token at
# all, so without this a service has nothing to check them against. The
# gateway sends it as X-Gateway-Token on every forward; each service compares
# it and answers 403 if it is absent or wrong.
#
# Same value in the gateway and all three services. It is not a user
# credential and never reaches a browser: rotate it by changing it in all four
# and restarting, in any order -- a mismatch fails closed.
GATEWAY_TOKEN=
